-- AIM ASSIST TARGET SELECTION
local function GetAimTarget()
    local Camera = workspace.CurrentCamera
    if not Camera then
        return nil
    end

    local BestTarget = nil
    local BestDistance = Settings.FOV
    local ViewportCenter = Camera.ViewportSize / 2

    for _, Target in ipairs(Players:GetPlayers()) do
        if Target == LocalPlayer then
            continue
        end

        if Settings.TeamCheck
            and LocalPlayer.Team ~= nil
            and Target.Team == LocalPlayer.Team then
            continue
        end

        local Character = Target.Character
        local Head = Character and Character:FindFirstChild("Head")
        local Humanoid = Character
            and Character:FindFirstChildOfClass("Humanoid")

        if Head and Humanoid and Humanoid.Health > 0 then
            local ScreenPosition, OnScreen =
                Camera:WorldToViewportPoint(Head.Position)

            if OnScreen then
                local ScreenDistance = (
                    Vector2.new(ScreenPosition.X, ScreenPosition.Y)
                    - ViewportCenter
                ).Magnitude

                if ScreenDistance < BestDistance then
                    BestDistance = ScreenDistance
                    BestTarget = Head
                end
            end
        end
    end

    return BestTarget
end

-- MAIN UPDATE
Connections.Render = RunService.RenderStepped:Connect(function()
    UpdateESP()

    if not Settings.AimEnabled then
        return
    end

    local Camera = workspace.CurrentCamera
    if not Camera then
        return
    end

    local Target = GetAimTarget()

    if Target then
        local Goal = CFrame.lookAt(
            Camera.CFrame.Position,
            Target.Position
        )

        Camera.CFrame = Camera.CFrame:Lerp(
            Goal,
            math.clamp(Settings.Smoothness, 0, 1)
        )
    end
end)

-- NEW PLAYERS AND RESPAWNS
local function SetupPlayer(Target)
    if Target == LocalPlayer then
        return
    end

    Connections[Target] =
        Target.CharacterAdded:Connect(function()
            task.wait(1)
            if Settings.ESPEnabled then
                CreateESP(Target)
            end
        end)
end

for _, Target in ipairs(Players:GetPlayers()) do
    SetupPlayer(Target)
end

Connections.PlayerAdded = Players.PlayerAdded:Connect(SetupPlayer)

Connections.PlayerRemoving = Players.PlayerRemoving:Connect(function(Target)
    RemoveESP(Target)

    if Connections[Target] then
        Connections[Target]:Disconnect()
        Connections[Target] = nil
    end
end)

-- CLEANUP
script.Destroying:Connect(function()
    for Target in pairs(ESPObjects) do
        RemoveESP(Target)
    end

    for _, Connection in pairs(Connections) do
        if typeof(Connection) == "RBXScriptConnection" then
            Connection:Disconnect()
        end
    end

    Gui:Destroy()
end)
