-- ESP CLEANUP
local function RemoveESP(Target)
    local Objects = ESPObjects[Target]

    if Objects then
        for _, Object in ipairs(Objects) do
            if Object and Object.Parent then
                Object:Destroy()
            end
        end

        ESPObjects[Target] = nil
    end
end

-- CREATE ESP
local function CreateESP(Target)
    if Target == LocalPlayer then
        return
    end

    local Character = Target.Character
    if not Character then
        return
    end

    local Head = Character:FindFirstChild("Head")
    if not Head then
        return
    end

    RemoveESP(Target)

    -- Highlight visible through walls
    local Highlight = Instance.new("Highlight")
    Highlight.Name = "AdminPlayerHighlight"
    Highlight.Adornee = Character
    Highlight.FillColor = Color3.fromRGB(65, 155, 255)
    Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    Highlight.FillTransparency = 0.55
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Enabled = Settings.ESPEnabled
    Highlight.Parent = Character

    -- Player label visible through walls
    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "AdminPlayerLabel"
    Billboard.Adornee = Head
    Billboard.Size = UDim2.fromOffset(200, 45)
    Billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Enabled = Settings.ESPEnabled
    Billboard.Parent = PlayerGui

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.fromScale(1, 1)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    Label.TextStrokeTransparency = 0.15
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamBold
    Label.Parent = Billboard

    ESPObjects[Target] = {
        Highlight,
        Billboard,
        Label
    }
end

-- UPDATE ESP
local function UpdateESP()
    local MyCharacter = LocalPlayer.Character
    local MyRoot = MyCharacter
        and MyCharacter:FindFirstChild("HumanoidRootPart")

    for _, Target in ipairs(Players:GetPlayers()) do
        if Target == LocalPlayer then
            continue
        end

        local Character = Target.Character
        local Humanoid = Character
            and Character:FindFirstChildOfClass("Humanoid")
        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        if not MyRoot or not Root or not Humanoid
            or Humanoid.Health <= 0 then
            RemoveESP(Target)
            continue
        end

        local Distance = (MyRoot.Position - Root.Position).Magnitude

        local SameTeam = Settings.TeamCheck
            and LocalPlayer.Team ~= nil
            and Target.Team == LocalPlayer.Team

        if Distance > Settings.MaxDistance or SameTeam then
            RemoveESP(Target)
            continue
        end

        if not ESPObjects[Target] then
            CreateESP(Target)
        end

        local Objects = ESPObjects[Target]

        if Objects then
            local Highlight = Objects[1]
            local Billboard = Objects[2]
            local Label = Objects[3]

            Highlight.Enabled = Settings.ESPEnabled
            Billboard.Enabled = Settings.ESPEnabled

            local TextParts = {}

            if Settings.ShowNames then
                table.insert(TextParts, Target.DisplayName)
            end

            if Settings.ShowDistance then
                table.insert(
                    TextParts,
                    string.format("%d studs", Distance)
                )
            end

            Label.Text = table.concat(TextParts, " | ")
        end
    end
end

